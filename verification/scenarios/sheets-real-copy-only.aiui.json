{
  "version": 1,
  "name": "rudra-policy-sheets-real-copy-only",
  "application": {
    "command": "C:\\Users\\PUBLIC_USER\\Documents\\RudraOffice\\releases\\rc28\\rudra-office-app.exe",
    "window_title": "Rudra Office"
  },
  "options": {
    "stop_on_error": true,
    "evidence_on_failure": true
  },
  "steps": [
    {
      "session": "app",
      "op": "session.open",
      "save_session_as": "app"
    },
    {
      "save_as": "startup",
      "session": "app",
      "op": "inspect_ui"
    },
    {
      "session": "app",
      "op": "click",
      "id": "rudra-office/menu/file-trigger"
    },
    {
      "session": "app",
      "timeout_ms": 5000,
      "op": "wait_idle"
    },
    {
      "value": "C:\\Users\\PUBLIC_USER\\Desktop\\private-acceptance-workbook.xlsx",
      "session": "app",
      "op": "set_value",
      "id": "rudra-office/action/open"
    },
    {
      "value": "C:\\Users\\PUBLIC_USER\\Desktop\\private-acceptance-workbook.xlsx",
      "session": "app",
      "op": "wait_for_value",
      "id": "rudra-office/action/open"
    },
    {
      "session": "app",
      "op": "click",
      "id": "rudra-office/action/open"
    },
    {
      "session": "app",
      "op": "wait_for_automation_id",
      "id": "rudra-office/document:1/sheets/grid"
    },
    {
      "save_as": "real-document",
      "session": "app",
      "op": "inspect_ui"
    },
    {
      "session": "app",
      "op": "click",
      "id": "rudra-office/menu/data-trigger"
    },
    {
      "value": "A1",
      "session": "app",
      "op": "set_value",
      "id": "rudra-office/sheets/address-input"
    },
    {
      "session": "app",
      "op": "click",
      "id": "rudra-office/ribbon/go-to-range"
    },
    {
      "value": "A1:A1",
      "session": "app",
      "op": "wait_for_value",
      "id": "rudra-office/document:1/sheets/selection"
    },
    {
      "session": "app",
      "op": "click",
      "id": "rudra-office/menu/home-trigger"
    },
    {
      "save_as": "source-russian-value",
      "session": "app",
      "op": "read",
      "id": "rudra-office/home/sheets/cell-value"
    },
    {
      "value": "Наименование",
      "session": "app",
      "op": "wait_for_value",
      "id": "rudra-office/home/sheets/cell-value"
    },
    {
      "session": "app",
      "op": "click",
      "id": "rudra-office/home/sheets/copy"
    },
    {
      "op": "inspect_ui",
      "session": "app",
      "save_as": "inspect-17"
    },
    {
      "op": "screenshot_window",
      "session": "app",
      "step": "final"
    },
    {
      "op": "get_runtime_health",
      "session": "app"
    },
    {
      "op": "get_runtime_stderr",
      "session": "app"
    },
    {
      "op": "windows_export_evidence",
      "session": "app"
    }
  ],
  "teardown": [
    {
      "op": "session.close",
      "session": "app"
    }
  ]
}
